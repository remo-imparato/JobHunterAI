@implements IDisposable
@inject DashboardClient Client
@inject DashboardPreferences Preferences
@inject ILogger<DashboardOverview> Logger

@if (Preferences.CandidateId == Guid.Empty)
{
    <MudAlert Severity="Severity.Info"><MudLink Href="/candidates">Select a candidate</MudLink> to view your dashboard.</MudAlert>
}
else
{
    <MudButton OnClick="LoadAsync" Disabled="_loading" Class="mb-4">Refresh</MudButton>
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" aria-label="Loading summary" />
    }
    else if (_error)
    {
        <MudAlert Severity="Severity.Error">Unable to load summary. Check API connectivity and database configuration, then refresh.</MudAlert>
    }
    else if (_summary is not null)
    {
        <MudGrid>
            @foreach (DashboardMetric metric in Metrics())
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudPaper Class="pa-4" Outlined="true">
                        <MudText Typo="Typo.subtitle1">@metric.Label</MudText>
                        <MudText Typo="Typo.h4">@metric.Count</MudText>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
        <MudText Typo="Typo.h5" Component="h2" Class="mt-6 mb-3">Application pipeline</MudText>
        @if (_summary.ApplicationStatuses.Count == 0)
        {
            <MudText>No applications recorded for this candidate.</MudText>
        }
        @foreach (DashboardMetric status in _summary.ApplicationStatuses)
        {
            <MudText Class="mt-3">@status.Label: @status.Count</MudText>
            <MudProgressLinear Value="@Percentage(status.Count)" Color="Color.Primary" aria-label="@status.Label" />
        }
    }
}

@code {
    private DashboardSummary? _summary;
    private bool _loading;
    private bool _error;
    private readonly CancellationTokenSource _lifetime = new();
    protected override Task OnInitializedAsync() => Preferences.CandidateId == Guid.Empty ? Task.CompletedTask : LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = false;
        try { _summary = await Client.SummarizeAsync(Preferences.CandidateId, _lifetime.Token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        {
            Logger.LogWarning(ex, "Dashboard summary unavailable");
            _error = true;
        }
        finally { _loading = false; }
    }

    private double Percentage(int count) => _summary!.Applications == 0 ? 0 : 100d * count / _summary.Applications;
    private DashboardMetric[] Metrics() =>
    [
        new("Discovered jobs (all candidates)", _summary!.Jobs),
        new("Applications", _summary.Applications),
        new("Resume versions", _summary.ResumeVersions),
        new("Cover letters", _summary.CoverLetters),
        new("Running agent executions", _summary.RunningExecutions)
    ];
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
