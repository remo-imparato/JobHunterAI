@page "/automation-queue"
<PageTitle>Automation Queue — JobHunterAI</PageTitle>
<MudText Typo="Typo.h4" Component="h1" Class="mb-4">Automation Queue</MudText>
<MudAlert Severity="Severity.Info" Class="mb-4">Recorded candidate agent executions. Hangfire scheduling is opt-in in the API configuration; this is not a view of pending Hangfire jobs. This page never submits applications.</MudAlert>
<ResourceTable Resource="DashboardResource.AutomationQueue" Filters="@Statuses" />
@code { private static readonly string[] Statuses = Enum.GetNames<JobHunterAI.Domain.AgentExecutionStatus>(); }
