{
  "ConnectionStrings": {
    "JobHunterAI": "Host=localhost;Port=5432;Database=jobhunterai;Username=jobhunterai;Password=jobhunterai"
  },
  "Database": {
    "SeedDevelopmentData": true
  },
  "JobHunterAI": {
    "DisplayName": "JobHunterAI"
  },
  "Background": {
    "Enabled": true,
    "EnableAiJobs": true,
    "BatchSize": 10,
    "ScoreRefreshHours": 24,
    "LogRetentionDays": 30,
    "LogDirectory": null,
    "Boards": [],
    "Candidates": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
